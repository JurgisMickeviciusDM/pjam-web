# ---------------------------------------------------------------------------
# P&J Asset Management — environment variables
# Copy to `.env` for local development. Set these in your VPS / compose too.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (Postgres on localhost):
DATABASE_URL="postgresql://pj:pjpassword@localhost:5432/pjam?schema=public"

# Secret used to sign session cookies. MUST be a long random string in prod.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Public base URL of the site (used for metadata / absolute URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed credentials (used by `npm run db:seed`). Change before going live.
ADMIN_EMAIL="admin@pjassetmanagement.com"
ADMIN_PASSWORD="ChangeMe!2026"
DEMO_CLIENT_EMAIL="client@pjassetmanagement.com"
DEMO_CLIENT_PASSWORD="ClientDemo!2026"

# Run the seed automatically on container start (docker-compose). true/false.
SEED_ON_START="true"

# ---- SMTP (optional) ------------------------------------------------------
# If unset, contact-form submissions are still saved to the database and
# logged to the server console instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@pjassetmanagement.com"
CONTACT_TO="enquiries@pjassetmanagement.com"
